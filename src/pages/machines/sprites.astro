---
import Base from '../../layouts/Base.astro';
import { recentCommits } from '../../lib/git.ts';
import { describeSprite, displayName, spriteParams } from '../../lib/spriteParams.ts';
import { actLabel, renderSprite } from '../../lib/spriteArt.ts';
import { spriteStory } from '../../lib/spriteStory.ts';

const initial = recentCommits(1)[0]?.hash ?? 'hello world';
const params = spriteParams(initial);
---

<Base title="Black Company Sprite Machine" description="Type a name, or anything at all, and meet the grim little character it belongs to. Fan art in the style of Glen Cook's The Black Company.">
  <div class="page-intro">
    <h1>Black Company Sprite Machine</h1>
    <p>Type a name, or anything at all, to meet the character it belongs to. Leave a hash and it names them for you.</p>
    <p class="sprite-credit">Fan art in the style of Glen Cook's <cite>The Black Company</cite> series.</p>
  </div>
  <section class="panel machine">
    <div class="sprite-motion">
      <p data-sprite-motion-note>Sprites breathe, blink and act when clicked.</p>
      <button type="button" class="pill-btn ghost" data-sprite-motion-toggle aria-pressed="false">Animate</button>
    </div>
    <form class="machine-input" data-sprite-form data-initial={initial}>
      <label class="visually-hidden" for="sprite-seed">A name, or any text</label>
      <input id="sprite-seed" name="seed" value={initial} autocomplete="off" spellcheck="false" />
      <button type="button" class="pill-btn ghost" data-random>Random</button>
    </form>
    <figure class="sprite">
      <div class="sprite-holder" data-sprite-holder>
        <button type="button" class="sprite-stage" data-sprite-art aria-label={actLabel(params)} set:html={renderSprite(params)} />
        <span class="sprite-click" aria-hidden="true">click!</span>
      </div>
      <figcaption>
        <h2 class="sprite-name" data-sprite-name>{displayName(params.name)}</h2>
        <p class="sprite-meta" data-sprite-meta>{describeSprite(params)}</p>
        <dl class="sprite-ledger" data-sprite-ledger>
          {spriteStory(params).map(({ label, text }) => <><dt>{label}</dt><dd>{text}</dd></>)}
        </dl>
      </figcaption>
    </figure>
  </section>

  <details class="panel machine explainer">
    <summary>
      <span class="explainer-title">How it works</span>
      <span class="explainer-hint">Expand to learn how this works</span>
    </summary>
    <div class="prose">
      <p>
        Every name, word or scrap of gibberish belongs to exactly one member of the company. Type the same thing twice
        and you meet the same character, down to the last pixel and the last line of their record.
      </p>

      <h2>From a name to a character</h2>
      <p>
        Whatever you type is hashed into a seed, and the seed rolls a fixed sequence of dice. The first roll picks a
        build: one of three body types. The next picks what they are in the company. Then one hand-drawn part for
        each slot: a face, an expression, sometimes a mark, headgear, a torso, legs, sometimes a cloak, and a weapon.
        The parts are drawn on the same 32×32 template, facing left and lit from the top left, so any of them fit
        together.
      </p>
      <p>
        Parts carry no colours of their own. Each pixel names a material and a shade, and the seed picks a muted
        palette for each material: skin, hair, cloth, trim, leather, metal, wood and bone. About one character in five
        comes out wrong: a blighted palette and eyes that glow green.
      </p>

      <h2>The company</h2>
      <ul>
        <li><strong>Sellswords</strong> with a falchion or a spear</li>
        <li><strong>Crossbowmen</strong> in leather jerkins and broad hats</li>
        <li><strong>Fallen knights</strong> in chainmail and battered great helms, swinging warhammers</li>
        <li><strong>Gravediggers</strong> with a lantern and a dagger</li>
        <li><strong>Hedge-wizards</strong> with an ember-tipped staff</li>
        <li><strong>Cultists</strong>, faces lost in pointed cowls, carrying sickles</li>
        <li><strong>Scouts</strong> with shortbows</li>
        <li>and, less often, one of <strong>the Taken</strong>: masked sorcerers who always glow</li>
      </ul>
      <p>
        Very rarely, about one name in a hundred, something else answers: a <strong>forvalaka</strong>.
      </p>

      <h2>Names and records</h2>
      <p>
        If you type something, that is their name. Leave a hash and they get a nickname, chosen to fit what they
        wear or carry or how they look. The corrupted and the Taken go by titles instead. None of the names belong to
        characters from the books.
      </p>
      <p>
        Each character also gets an entry in the company's records, written by a dry annalist: where they enlisted;
        a few details from among their rank, reasons, kin, kit, marks, habits, debts, wounds and deeds; and how it
        ended, or hasn't yet. The Taken get a file of their own, and the forvalaka a bestiary entry.
      </p>

      <h2>Moving</h2>
      <p>
        At rest, every character breathes, blinks every few breaths on a beat of their own, and lets their cloak stir.
        Anything that glows flickers. Click a character, or tab to them and press Enter, and they act: a swing, a
        thrust, a cast, a shot, a pounce. If your device asks websites to reduce motion, they start still; the button at
        the top lets you animate them anyway.
      </p>

      <h2>The style</h2>
      <p>
        The look is 16-bit JRPG pixel art: chunky 32×32 sprites, a dark outline, a handful of shades per material. It is
        fan art in the style of Glen Cook's <cite>The Black Company</cite>, and the characters are invented, not
        taken from the books.
      </p>
    </div>
  </details>
</Base>

<script>
  import { describeSprite, displayName, spriteParams } from '../../lib/spriteParams.ts';
  import { actLabel, renderSprite } from '../../lib/spriteArt.ts';
  import { spriteStory } from '../../lib/spriteStory.ts';

  const form = document.querySelector<HTMLFormElement>('[data-sprite-form]')!;
  const input = form.querySelector('input')!;
  const initial = form.dataset.initial!;
  const art = document.querySelector<HTMLElement>('[data-sprite-art]')!;
  const nameEl = document.querySelector<HTMLElement>('[data-sprite-name]')!;
  const metaEl = document.querySelector<HTMLElement>('[data-sprite-meta]')!;
  const ledgerEl = document.querySelector<HTMLElement>('[data-sprite-ledger]')!;

  // A hash (the default, Random, or ?seed=) gets a generated name; typed text (or ?name=) is the name.
  function show(text: string, typed: boolean) {
    const params = spriteParams(text, typed);
    art.innerHTML = renderSprite(params);
    art.setAttribute('aria-label', actLabel(params));
    nameEl.textContent = displayName(params.name);
    metaEl.textContent = describeSprite(params);
    ledgerEl.replaceChildren(
      ...spriteStory(params).flatMap(({ label, text }) => {
        const dt = document.createElement('dt');
        const dd = document.createElement('dd');
        dt.textContent = label;
        dd.textContent = text;
        return [dt, dd];
      }),
    );
    const url = new URL(location.href);
    url.search = text === initial && !typed ? '' : new URLSearchParams({ [typed ? 'name' : 'seed']: text }).toString();
    history.replaceState(null, '', url);
  }

  input.addEventListener('input', () => {
    if (input.value.trim()) show(input.value, true);
    else show(initial, false);
  });
  form.addEventListener('submit', (e) => e.preventDefault());
  form.querySelector('[data-random]')!.addEventListener('click', () => {
    const bytes = crypto.getRandomValues(new Uint8Array(20));
    input.value = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
    show(input.value, false);
  });

  // Motion follows the viewer's reduced-motion setting until they choose with the toggle;
  // the choice is remembered in this browser and applies wherever sprites appear.
  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const toggle = document.querySelector<HTMLButtonElement>('[data-sprite-motion-toggle]')!;
  const note = document.querySelector<HTMLElement>('[data-sprite-motion-note]')!;
  const moving = () => (root.dataset.spriteMotion ? root.dataset.spriteMotion === 'on' : !reduce.matches);
  const showToggle = () => {
    toggle.setAttribute('aria-pressed', String(moving()));
    toggle.textContent = moving() ? 'Pause' : 'Animate';
    note.textContent =
      reduce.matches && !root.dataset.spriteMotion
        ? 'Your device asks websites to reduce motion, so the sprites start still. You can animate them anyway.'
        : 'Sprites breathe, blink and act when clicked.';
  };
  toggle.addEventListener('click', () => {
    root.dataset.spriteMotion = moving() ? 'off' : 'on';
    try {
      localStorage.setItem('sprite-motion', root.dataset.spriteMotion);
    } catch {}
    showToggle();
  });
  reduce.addEventListener('change', showToggle);
  showToggle();

  // A click plays the weapon's action once: each frame for its own duration, then back to idle.
  // With motion paused, it just holds the key frame (the strike) for a moment.
  let acting: number | undefined;
  art.addEventListener('click', () => {
    // The "click!" tag has done its job once they've clicked.
    document.querySelector('[data-sprite-holder]')!.classList.add('clicked');
    const svg = art.querySelector<SVGSVGElement>('svg');
    const durations = svg?.dataset.actMs?.split(',').map(Number);
    if (!svg || !durations) return;
    clearTimeout(acting);
    const steps = moving() ? durations.map((ms, i) => [i, ms]) : [[Math.min(1, durations.length - 1), 500]];
    const play = (n: number) => {
      if (n === steps.length) return delete svg.dataset.act;
      svg.dataset.act = String(steps[n][0]);
      acting = window.setTimeout(() => play(n + 1), steps[n][1]);
    };
    play(0);
  });

  const query = new URLSearchParams(location.search);
  const name = query.get('name')?.trim();
  const seed = query.get('seed')?.trim();
  if (name) {
    input.value = name;
    show(name, true);
  } else if (seed) {
    input.value = seed;
    show(seed, false);
  }
</script>
